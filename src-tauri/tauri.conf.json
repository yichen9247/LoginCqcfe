{
    "$schema": "https://schema.tauri.app/config/2",
    "version": "1.0.1",
    "productName": "LoginCqcfe",
    "identifier": "com.desktop.logincqcfe",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "width": 1400,
                "height": 800,
                "center": true,
                "label": "main",
                "shadow": false,
                "minWidth": 1000,
                "minHeight": 600,
                "devtools": true,
                "resizable": false,
                "fullscreen": false,
                "useHttpsScheme": false,
                "title": "重财校园网一键登录系统"
            }
        ],
        "security": {
            "csp": "default-src * 'unsafe-inline' 'unsafe-eval'; connect-src *; script-src * 'unsafe-inline' 'unsafe-eval'; style-src * 'unsafe-inline'; img-src * data:;"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/icon.ico",
            "icons/32x32.png",
            "icons/icon.icns",
            "icons/128x128.png",
            "icons/128x128@2x.png"
        ]
    }
}